<h1>Services</h1>

<% cols = Service.column_names - %w[created_at updated_at] %>
<table>
  <thead>
    <tr>
      <% cols.each { |c| %><th><%= c.titleize %></th><% } %>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @services.each do |service| %>
      <tr>
        <% cols.each { |c| %><td><%= service.public_send(c) %></td><% } %>
        <td><%= link_to "Show", service_path(service) %></td>
      </tr>
    <% end %>
  </tbody>
</table>
