<h1>Rooms</h1>

<% cols = Room.column_names - %w[created_at updated_at] %>

<table>
  <thead>
    <tr>
      <% cols.each do |c| %>
        <th><%= c.titleize %></th>
      <% end %>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @rooms.each do |room| %>
      <tr>
        <% cols.each do |c| %>
          <td><%= room.public_send(c) %></td>
        <% end %>
        <td><%= link_to "Show", room_path(room) %></td>
      </tr>
    <% end %>
  </tbody>
</table>
